{
  "name": "simplemusic",
  "productName": "Simple Music",
  "desktopName": "simple-music.desktop",
  "version": "2.7.0",
  "description": "简约音乐播放器",
  "author": "yshAM",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yyyangshenghao/simple-music.git"
  },
  "homepage": "https://github.com/Yyyangshenghao/simple-music",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:playback-probe": "electron-vite dev --config electron/playback-probe/vite.config.ts --entry out-probe/main/index.js",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "server:dev": "tsx server/index.ts",
    "eval:lyrics": "tsx scripts/lyrics-eval/run.mts",
    "release:check": "node scripts/release/check-release.mjs"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "koffi": "2.16.3",
    "mpg123-decoder": "^1.0.3",
    "music-metadata": "^11.16.1",
    "NeteaseCloudMusicApi": "^4.32.0",
    "onnxruntime-node": "1.30.0",
    "opencc-js": "^1.4.2",
    "qishui-music-api": "0.2.2",
    "qrc-decoder": "1.0.2",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^7.28.0",
    "webwallgl": "^3.0.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^8.17.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xmldom/xmldom": "^0.8.13",
    "d3-force": "^3.0.0",
    "electron": "git+https://github.com/castlabs/electron-releases.git#v42.11.0+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "motion": "^12.42.1",
    "onnxruntime-web": "^1.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.169.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "simplemusic": {
    "update": {
      "provider": "github",
      "owner": "Yyyangshenghao",
      "repo": "simple-music",
      "preview": true,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "build": {
    "appId": "com.simplemusic.desktop",
    "productName": "Simple Music",
    "afterPack": "build/vmp-sign-macos.cjs",
    "afterSign": "build/vmp-sign-windows.cjs",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/build/koffi/**/*.node",
      "node_modules/onnxruntime-node/bin/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "files": [
        "out/**/*",
        "build/icon.ico",
        "build/icon.png",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/{linux,win32}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/!(${arch})/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/libonnxruntime.*.*.dylib"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "files": [
        "out/**/*",
        "build/icon.ico",
        "build/icon.png",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/!(${arch})/**"
      ]
    },
    "dmg": {
      "artifactName": "Simple-Music-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simple Music",
      "artifactName": "Simple-Music-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Simple-Music-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "简约音乐播放器",
      "description": "简约音乐播放器：网易云音乐 / QQ 音乐 / Apple Music / 本地音乐，支持动态歌词、桌面歌词与迷你播放条。",
      "maintainer": "yshAM",
      "executableName": "simple-music",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Simple Music",
          "Comment": "简约音乐播放器",
          "StartupWMClass": "simple-music",
          "Keywords": "music;player;lyrics;netease;qq;apple;"
        }
      },
      "artifactName": "Simple-Music-${version}-${arch}.${ext}",
      "files": [
        "out/**/*",
        "build/icon.ico",
        "build/icon.png",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/!(${arch})/**"
      ]
    }
  }
}
